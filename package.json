{
  "name": "@localize-work/i18next-backend",
  "version": "0.10.0",
  "description": "i18next backend plugin for localize.work — loads published translation JSON from the CDN, posts missing keys back to the API in development, and lets translators edit strings in the running app",
  "keywords": [
    "i18next",
    "backend",
    "i18next-backend",
    "localization",
    "translation",
    "localize.work"
  ],
  "license": "MIT",
  "homepage": "https://localize.work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localize-work/localize-work-i18next-backend.git"
  },
  "bugs": "https://github.com/localize-work/localize-work-i18next-backend/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./in-context": {
      "import": {
        "types": "./dist/in-context.d.ts",
        "default": "./dist/in-context.js"
      },
      "require": {
        "types": "./dist/in-context.d.cts",
        "default": "./dist/in-context.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepublishOnly": "pnpm run build",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "i18next": "^23.0.0 || ^24.0.0 || ^25.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "i18next": "^26.3.6",
    "jsdom": "^31.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.0.0"
}
